<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AbsoluteRP.Renderer</AssemblyName>
    <RootNamespace>AbsoluteRP.Video.Renderer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Drop our build output into the plugin's bin (next to AbsoluteRP.dll)
         so DalamudPackager picks up the renderer\ folder when zipping. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\x64\$(Configuration)\renderer\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="scripts\**" />
    <EmbeddedResource Remove="scripts\**" />
    <None Remove="scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- LibVLC replaces CefSharp.OffScreen as the media engine. The CEF
         path was a stack of escalating workarounds (audio-routing IPC
         broken on CEF 138 offscreen, NVIDIA driver crashes on hardware
         video decode, autoplay-policy quirks, frame production hangs).
         libVLC is built for media playback - HLS, DASH, MP4, etc.
         decoded with audio routed to Windows directly and video frames
         delivered via a SetVideoCallbacks lock/display pair, which
         maps cleanly to our existing MmfFrameWriter.

         LibVLCSharp - managed wrapper, gives us the typed MediaPlayer
                       API and the SetVideoCallbacks signatures.
         VideoLAN.LibVLC.Windows - drops the native libvlc.dll +
                       libvlccore.dll + plugins/ folder into the build
                       output. ~30 MB of binaries; comparable to what
                       CEF was shipping. -->
    <PackageReference Include="LibVLCSharp" Version="3.9.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Rpc.cs (the JSON wire format shared with the plugin) is linked in
       from the plugin project rather than duplicated here or referenced
       via a third assembly — see the note in the plugin's csproj. -->
  <ItemGroup>
    <Compile Include="..\Video\Rpc.cs" Link="Rpc.cs" />
  </ItemGroup>
</Project>
