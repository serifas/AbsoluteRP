<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Authors>Lynie</Authors>
        <Version>0.0.4.4</Version>
        <AssemblyName>AbsoluteRoleplay</AssemblyName>
        <Description>An all around Roleplay Plugin.</Description>
        <PackageProjectUrl>https://github.com/serifas/AbsoluteRP</PackageProjectUrl>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <IsPackable>true</IsPackable>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>x64</Platforms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
		<TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
	</PropertyGroup>

	<ItemGroup>
		<!-- The renderer is its own executable (built by the BuildRenderer
		     target below); keep its sources and obj out of the plugin. -->
		<Compile Remove="Absolute Roleplay\**" />
		<Compile Remove="AbsoluteRP.Renderer\**" />
		<EmbeddedResource Remove="Absolute Roleplay\**" />
		<EmbeddedResource Remove="AbsoluteRP.Renderer\**" />
		<None Remove="AbsoluteRP.Renderer\**" />
		<Compile Remove="client\**" />
		<EmbeddedResource Remove="client\**" />
		<None Remove="client\**" />
	</ItemGroup>


    <!-- Explicit dependencies -->
    <ItemGroup>
        <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4181-prerelease" />
        <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
        <PackageReference Include="K4os.Compression.LZ4.Legacy" Version="1.3.8" />
        <PackageReference Include="MessagePack" Version="3.1.8" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="NAudio" Version="3.0.2-preview.2" />
        <PackageReference Include="NReco.Logging.File" Version="1.4.0" />
        <PackageReference Include="System.Drawing.Common" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
        <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <Target Name="BuildRenderer" AfterTargets="Build" BeforeTargets="DefaultDalamudPackagerRelease;DefaultDalamudPackagerDebug">
        <!-- Restore runs in its own evaluation so the Build call sees the
             freshly restored packages. Platform is pinned: the renderer
             only has an x64 configuration.
             OutputPath is handed down from THIS project's real output
             folder: a command-line build (AnyCPU) lands in bin\Release\,
             a Visual Studio x64 build in bin\x64\Release\, and the plugin
             looks for renderer\ next to its own DLL either way. A global
             property overrides the renderer's own default path. -->
        <MSBuild Projects="AbsoluteRP.Renderer\AbsoluteRP.Renderer.csproj" Properties="Configuration=$(Configuration);Platform=x64;_RendererRestore=true" Targets="Restore" />
        <MSBuild Projects="AbsoluteRP.Renderer\AbsoluteRP.Renderer.csproj" Properties="Configuration=$(Configuration);Platform=x64;OutputPath=$(TargetDir)renderer\" Targets="Build" />
    </Target>

    <!-- The WebView2 package references its WPF control assembly for every
         .NET app, but the plugin only uses the WinForms control
         (YouTubePlayerWindow). That unused WPF assembly wants a newer
         WindowsBase than the runtime's, which is the MSB3277 warning.
         Package targets add the reference after this file's items, so it
         has to be dropped in a target, just before references resolve. -->
    <Target Name="DropUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="$(ProjectDir)UI\**" CopyToOutputDirectory="Always" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
    </ItemGroup>

    <!-- Force Windows Desktop framework to 10.0.0 for plogon CI compatibility -->
    <ItemGroup>
        <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App" IsWindowsOnly="false" TargetingPackVersion="10.0.0" />
        <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App.WPF" IsWindowsOnly="false" TargetingPackVersion="10.0.0" />
        <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App.WindowsForms" IsWindowsOnly="false" TargetingPackVersion="10.0.0" />
    </ItemGroup>
</Project>
